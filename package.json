{
  "name": "metrojs-web",
  "private": true,
  "scripts": {
    "set-memory": "cross-env NODE_OPTIONS='--max-old-space-size=1024'",
    "build": "pnpm set-memory && turbo run build --concurrency=8",
    "build:prod": "pnpm set-memory && turbo run build:prod --concurrency=8",
    "build:staging": "pnpm set-memory && turbo run build:staging --concurrency=8",
    "build:sourcemap": "turbo run build:sourcemap --filter=webapp",
    "build:staging:sourcemap": "turbo run build:staging:sourcemap --filter=webapp",
    "clear": "turbo run clear --filter=webapp",
    "dev": "turbo run dev --filter=webapp",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit fix",
    "clean-install": "node -e \"const os = require('os'); const path = require('path'); const { execSync } = require('child_process'); const script = os.platform() === 'win32' ? 'tools\\\\clean-install.bat' : 'tools/clean-install.sh'; execSync(script, { stdio: 'inherit' });\"",
    "start": "pnpm set-memory && pnpm --filter webapp start",
    "gen:db": "pnpm set-memory && pnpm --filter @repo/common run gen:db",
    "gen:db:staging": "pnpm set-memory && pnpm --filter @repo/common run gen:db:staging",
    "gen:db:prod": "pnpm set-memory && pnpm --filter @repo/common run gen:db:prod",
    "gen:dao": "pnpm set-memory && pnpm --filter @repo/common run gen:dao",
    "gen:form": "pnpm set-memory && pnpm --filter @repo/common run gen:form",
    "gen:form_test": "pnpm set-memory && pnpm --filter @repo/common run gen:form_test",
    "gen:all": "pnpm set-memory && pnpm gen:db && pnpm gen:dao && pnpm gen:form && pnpm gen:form_test",
    "prestart:staging": "pnpm set-memory",
    "prestart:prod": "pnpm set-memory",
    "start:staging": "pnpm --filter webapp start:staging",
    "start:prod": "pnpm --filter webapp start:prod"
  },
  "devDependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/runtime": "^7.26.9",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.1",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.4.4",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@mui/x-telemetry",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "core-js",
      "core-js-pure",
      "es5-ext",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "@babel/traverse": "^7.24.0",
      "postcss": "^8.5.3",
      "@swc/core": "^1.11.21",
      "rimraf": "^6.0.5",
      "minimatch": "^10.2.2",
      "ajv": ">=6.14.0",
      "cookie": ">=0.7.0",
      "tmp": ">=0.2.4"
    }
  },
  "dependencies": {
    "@esbuild/win32-x64": "0.25.2",
    "@next/swc-win32-x64-msvc": "14.1.3",
    "@turbo/codemod": "^2.5.1"
  }
}
