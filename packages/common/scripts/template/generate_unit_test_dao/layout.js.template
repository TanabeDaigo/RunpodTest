"use client";

import { Box, Typography } from "@mui/material";
import { TestDialogHeader, TestDialogMainTitle } from "./styles";

/**
 * DAOテストページのレイアウトコンポーネント
 */
export default function Layout({ children }) {
  return (
    <Box sx={{ padding: 3 }}>
      <TestDialogHeader>
        <TestDialogMainTitle>DAO Unit Test</TestDialogMainTitle>
      </TestDialogHeader>
      {children}
    </Box>
  );
}
