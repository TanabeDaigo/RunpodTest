{
  "name": "@krono-metro/metrojs",
  "version": "0.1.29",
  "description": "MetroJS is a library for building web applications.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krono-Metro/metrojs.git",
    "directory": "metrojs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "src/**/*",
    "dist/**/*",
    "*.d.ts"
  ],
  "main": "./src/server/index.js",
  "browser": "./src/client/index.js",
  "types": "./src/server/index.d.ts",
  "exports": {
    "./server": {
      "types": "./src/server/index.d.ts",
      "import": "./src/server/index.js"
    },
    "./scripts": {
      "types": "./src/scripts/index.d.ts",
      "import": "./src/scripts/index.js"
    },
    "./client": {
      "types": "./src/client/index.d.ts",
      "import": "./src/client/index.js"
    },
    "./logjs": {
      "types": "./src/lib/logjs.d.ts",
      "import": "./src/lib/logjs.js"
    },
    "./jsonjs": {
      "types": "./src/lib/jsonjs.d.ts",
      "import": "./src/lib/jsonjs.js"
    },
    "./utils": {
      "types": "./src/utils/index.d.ts",
      "import": "./src/utils/index.js"
    },
    "./clearCache": {
      "types": "./src/scripts/clear-cache.d.ts",
      "import": "./src/scripts/clear-cache.js"
    },
    "./clean": {
      "types": "./src/scripts/clean.d.ts",
      "import": "./src/scripts/clean.js"
    },
    "./dayjs": {
      "types": "./src/lib/dayjs.d.ts",
      "import": "./src/lib/dayjs.js"
    },
    "./securityHeaders": {
      "types": "./src/securityHeaders.d.ts",
      "import": "./src/securityHeaders.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "build:staging": "tsc",
    "build:prod": "tsc",
    "clean": "node ./src/scripts/clean.js",
    "clear": "pnpm store prune && pnpm cache clean ",
    "pretest": "pnpm run clean && pnpm run build",
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.981.0",
    "@aws-sdk/client-sesv2": "^3.981.0",
    "@aws-sdk/client-sqs": "^3.981.0",
    "@aws-sdk/s3-request-presigner": "^3.981.0",
    "@tiptap/extension-color": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/extension-text-style": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "iconv-lite": "^0.6.3",
    "nodemailer": "^7.0.11",
    "pdf-parse": "^2.4.5",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dropzone": "^14.2.9",
    "react-virtualized": "^9.22.6",
    "sequelize": "^6.37.7",
    "tar-stream": "^3.1.7",
    "tiny-case": "^1.0.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "babel-jest": "^29.7.0",
    "dayjs": "^1.11.13",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "next": "^15.5.10",
    "typescript": "^5.3.3"
  }
}
