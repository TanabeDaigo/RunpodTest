{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "babel": {
    "presets": [
      "next/babel"
    ],
    "plugins": [
      [
        "@babel/plugin-proposal-decorators",
        {
          "legacy": true
        }
      ],
      "@babel/plugin-transform-class-properties"
    ]
  },
  "scripts": {
    "dev": "npm run clear && npm run gen:sv_index && concurrently \"node scripts/dev.js\" \"npm run watch-container:chokidar\"",
    "clear": "node scripts/clean.js && node scripts/clear-cache.js",
    "build": "cross-env NODE_ENV=production NEXT_PUBLIC_NODE_ENV=production next build",
    "build:staging": "cross-env NODE_ENV=production NEXT_PUBLIC_NODE_ENV=production next build",
    "build:prod": "cross-env NODE_ENV=production NEXT_PUBLIC_NODE_ENV=production next build",
    "build:sourcemap": "cross-env NODE_ENV=production NEXT_PUBLIC_NODE_ENV=production NEXT_SOURCEMAP=true next build ",
    "build:staging:sourcemap": "cross-env NODE_ENV=production NEXT_PUBLIC_NODE_ENV=production NEXT_SOURCEMAP=true next build",
    "start:sourcemap": "node scripts/start-sourcemap.js ",
    "start:staging:sourcemap": "node scripts/start-sourcemap.js staging",
    "analyze": "ANALYZE=true next build",
    "analyze:win": "set ANALYZE=true && next build",
    "prebuild": "pnpm run clear",
    "start:staging": "node scripts/start.js staging",
    "start": "node scripts/start.js production",
    "lint": "next lint",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:watch": "cross-env NODE_ENV=test  jest --watch",
    "watch-container": "nodemon --config nodemon.json",
    "watch-container:chokidar": "node scripts/watch-server.js",
    "reload-container": "node scripts/reload-container.js",
    "gen:sv_index": "node ./scripts/generate_server_index.js",
    "gemini:verify": "node scripts/gemini-verify.mjs",
    "ai-gateway:stub": "node scripts/ai-gateway-stub.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.18.6",
    "@aws-sdk/client-ses": "^3.658.1",
    "@aws-sdk/client-sqs": "^3.658.1",
    "@aws-sdk/credential-providers": "^3.658.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.2.5",
    "@krono-metro/metrojs": "workspace:*",
    "@langchain/core": "^1.2.3",
    "@langchain/ollama": "^1.3.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@mui/material-nextjs": "^7.0.2",
    "@mui/styled-engine-sc": "^7.0.2",
    "@mui/system": "^7.0.2",
    "@mui/x-data-grid": "^8.0.0",
    "@repo/common": "workspace:*",
    "@toolpad/core": "^0.14.0",
    "@upstash/redis": "^1.34.8",
    "cookie": "^1.0.2",
    "critters": "^0.0.25",
    "csv-parse": "^6.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "encoding-japanese": "^2.2.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "ioredis": "^5.6.1",
    "mysql2": "^3.14.0",
    "next": "^15.5.10",
    "next-auth": "5.0.0-beta.30",
    "node-cron": "^4.2.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11",
    "notistack": "^3.0.2",
    "path-browserify": "^1.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.14.1",
    "pg-hstore": "^2.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.5",
    "server-only": "^0.0.1",
    "styled-components": "^6.1.17",
    "tar-stream": "^3.1.7",
    "tiny-case": "^1.0.3",
    "ts-loader": "^9.5.2",
    "tsyringe": "^4.8.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-transform-class-properties": "^7.23.3",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^14.0.0",
    "@swc/core": "^1.11.20",
    "@swc/plugin-emotion": "^9.0.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.21",
    "chokidar": "^3.5.3",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.4",
    "gulp": "^5.0.0",
    "ignore-loader": "^0.1.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "minipass": "^7.1.1",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "postcss-loader": "^8.1.1",
    "rimraf": "^6.0.1",
    "source-map-explorer": "^2.5.3",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.1",
    "terser-webpack-plugin": "^5.3.14",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
