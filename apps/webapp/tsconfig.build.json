/*
 * __test__フォルダをコンパイル非対称にするために tsconfig.build.jsonを設定
 */{
  "compilerOptions": {
    // 省略
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    // 省略
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.tsx",
    "**/*.storybook.tsx"
  ]
}
